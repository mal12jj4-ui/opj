{
	"schemaVersion": 1,
	"id": "ggclient",
	"version": "${version}",
	"name": "GG Client",
	"description": "GG Client for DonutSMP. Based on the CC0 Adin client.",
	"authors": [
		"GG Client",
		"koifih (original Adin source, CC0)"
	],
	"license": "CC0-1.0",
	"icon": "assets/ggclient/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.ggclient.GG"
		],
		"client": [
			"dev.ggclient.client.GGClient"
		]
	},
	"mixins": [
		{
			"config": "ggclient.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "ggclient.donut.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
